      printf 'title\tDisconnected\nmounted\tno\ninternal_present\tno\ninternal_mounted\tno\nsd_present\tno\nsd_mounted\tno\ndevice_error\t\nplugin\t%s\ndevice\t—\nfirmware\t%s\nfirmware_state\t%s\nfirmware_installed\t%s\nfirmware_latest\t%s\nfirmware_backup\t%s\nfirmware_pending\t%s\nfirmware_pending_version\t%s\nfirmware_prepared\t%s\nfirmware_prepared_version\t%s\nfirmware_feed\t%s\nfirmware_checked_at\t%s\ninternal\t—\ninternal_percent\t0\nsd\t—\nsd_percent\t0\ntracks\t—\nalbums\t—\nformats\t—\ncategories\t—\nmanifests\t—\ncleanup\t—\nsync_state\tunavailable\nsync_new\t0\nsync_updated\t0\nsync_unchanged\t0\nsync_skipped\t0\nsync_unsupported\t0\nsync\t—\nimport_state\tunavailable\nimport_new\t0\nimport_conflicts\t0\nimport_unchanged\t0\nimport_skipped\t0\nimport_unsupported\t0\nimport\t—\n' \
        "$(plugin_version)" "$(firmware_status)" "$(firmware_state)" \
        "$(firmware_installed_version)" \
        "$([[ -f "$firmware_cache" ]] && head -n 1 "$firmware_cache" || echo unknown)" \
        "$(firmware_backup_status)" \
        "$(firmware_pending_status)" "$(firmware_pending_version)" \
        "$(firmware_prepared_status)" "$(firmware_prepared_version)" \
        "$(firmware_feed_status)" "$(firmware_checked_at)"
      ;;
  esac
}

refresh_details_cache() {
  local started_at
  [[ "$mode" != disconnected ]] || { emit_details; return; }
  mkdir -p "$cache_root" || { emit_details; return; }
  started_at="$(date +%s)"
  (
    local cache_mtime temporary
    flock -w 10 9 || return 75
    rescan_devices
    [[ "$mode" != disconnected ]] || { emit_details; return; }
    cache_mtime="$([[ -f "$details_cache" ]] && stat -c %Y "$details_cache" || echo 0)"
    if ((cache_mtime >= started_at)) \
        && grep -Fqx $'fingerprint\t'"$device_fingerprint" "$details_cache" 2>/dev/null; then
      read_cached_details
      return
    fi
    temporary="$(mktemp "$cache_root/.details.XXXXXX")" || { emit_details; return; }
    emit_details > "$temporary"
    cat "$temporary"
    if grep -Eq $'^(internal_mounted|sd_mounted)\tyes$' "$temporary" \
        || [[ "$mode" == dac ]]; then
      mv "$temporary" "$details_cache"
    else
      rm -f "$temporary"
    fi
  ) 9> "$device_lock"
}

run_device_action() {
  local action="$1"
  shift
  mkdir -p "$cache_root" || { echo "Could not create Echo Shelf cache"; return 1; }
  emit_progress 2 "Waiting for Echo"
  (
    set -e
    flock -w 20 9 || { echo "Echo Mini is busy; try again"; return 1; }
    rescan_devices
    "$action" "$@"
  ) 9> "$device_lock"
}

