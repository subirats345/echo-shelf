#!/usr/bin/env bash

set -u

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
config_root="${XDG_CONFIG_HOME:-$HOME/.config}/echo-shelf"
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/echo-shelf"
firmware_config="$config_root/firmware-version"
firmware_cache="$cache_root/latest-firmware"
firmware_url_cache="$cache_root/latest-firmware-url"
details_cache="$cache_root/details"
device_lock="$cache_root/device.lock"
firmware_pending="$config_root/firmware-pending"
firmware_prepared="$config_root/firmware-prepared"
firmware_url="https://forum.fiio.com/phoneNote/showNoteContent.do?id=202501210934383987154"

mode=disconnected
internal_device=
internal_mount=
sd_device=
sd_mount=
scan_error=
runtime_error=
device_fingerprint=disconnected
connection_token=disconnected
mount_token=disconnected
echo_fingerprint=unknown
music_root="$(xdg-user-dir MUSIC 2>/dev/null || true)"
[[ -n "$music_root" ]] || music_root="$HOME/Music"
inbox="$music_root/Echo Shelf Inbox"
library="$music_root/Echo Shelf Library"
firmware_store="$cache_root/firmware"
firmware_backup_root="$music_root/Echo Shelf Firmware Backups"

ensure_inbox() {
  [[ -d "$inbox" ]] || mkdir -p "$inbox"
}

open_inbox() {
  ensure_inbox || { echo "Could not create Inbox: $inbox"; return 1; }
  command -v xdg-open >/dev/null || { echo "Could not open Inbox"; return 1; }
  xdg-open "$inbox" >/dev/null 2>&1 &
  echo "Inbox opened"
}

open_library() {
  mkdir -p "$library" || { echo "Could not create Library: $library"; return 1; }
  command -v xdg-open >/dev/null || { echo "Could not open Library"; return 1; }
  xdg-open "$library" >/dev/null 2>&1 &
  echo "Library opened"
}

check_runtime() {
  local command
  for command in udevadm findmnt lsblk sha256sum flock timeout; do
    command -v "$command" >/dev/null || {
      runtime_error="Missing required command: $command"
      mode=error
      return 1
    }
  done
}

require_commands() {
  local command
  for command in "$@"; do
    command -v "$command" >/dev/null \
      || { echo "Missing required command: $command"; return 1; }
  done
}

scan_devices() {
  local device properties model devname devtype mountpoint
  local internal_count=0 sd_count=0

  for device in /sys/class/block/*; do
    properties="$(udevadm info --query=property --path="$device" 2>/dev/null || true)"
    grep -q '^ID_VENDOR_ID=071b$' <<<"$properties" || continue
    grep -q '^ID_MODEL_ID=3203$' <<<"$properties" || continue
    mode=data
    devtype="$(sed -n 's/^DEVTYPE=//p' <<<"$properties")"
    [[ "$devtype" == partition ]] || continue
    model="$(sed -n 's/^ID_MODEL=//p' <<<"$properties")"
    devname="$(sed -n 's/^DEVNAME=//p' <<<"$properties")"
    mountpoint="$(findmnt -n -S "$devname" -o TARGET 2>/dev/null || true)"
    if [[ "$model" == MINI ]]; then
      internal_count=$((internal_count + 1))
      if [[ -z "$internal_device" ]]; then
        internal_device="$devname"
        internal_mount="$mountpoint"
      fi
    elif [[ "$model" == MINI_SD ]]; then
      sd_count=$((sd_count + 1))
      if [[ -z "$sd_device" ]]; then
        sd_device="$devname"
        sd_mount="$mountpoint"
      fi
    fi
  done

  if ((internal_count > 1 || sd_count > 1)); then
    scan_error="Multiple Echo Mini devices detected"
  fi

  [[ "$mode" == data ]] && return

  for device in /sys/class/sound/card*; do
    properties="$(udevadm info --query=property --path="$device" 2>/dev/null || true)"
    if grep -q '^ID_VENDOR_ID=071b$' <<<"$properties" \
        && grep -q '^ID_MODEL_ID=3205$' <<<"$properties"; then
      mode=dac
      return
    fi
  done
}

hash_identity() {
  sha256sum | awk '{ print $1 }'
}

block_identity() {
  local device="$1" properties size uuid model serial
  [[ -n "$device" ]] || { echo absent; return; }
  properties="$(udevadm info --query=property --name="$device" 2>/dev/null || true)"
  size="$(lsblk -bno SIZE "$device" 2>/dev/null | tr -d ' ' | head -n 1)"
  uuid="$(lsblk -nro UUID "$device" 2>/dev/null | head -n 1)"
  model="$(sed -n 's/^ID_MODEL=//p' <<<"$properties" | head -n 1)"
  serial="$(sed -n 's/^ID_SERIAL_SHORT=//p' <<<"$properties" | head -n 1)"
  printf '%s|%s|%s|%s\n' "${serial:-none}" "${uuid:-none}" "${size:-0}" "${model:-none}"
}

block_connection_sequence() {
  local device="$1" parent sequence
  [[ -n "$device" ]] || { echo absent; return; }
  parent="$(lsblk -nro PKNAME "$device" 2>/dev/null | head -n 1)"
  sequence="$(lsblk -dnro DISKSEQ "/dev/${parent:-${device#/dev/}}" 2>/dev/null | head -n 1)"
  printf '%s|%s\n' "$device" "${sequence:-unknown}"
}

refresh_device_identity() {
  local internal_identity sd_identity
  case "$mode" in
    data)
      internal_identity="$(block_identity "$internal_device")"
      sd_identity="$(block_identity "$sd_device")"
      echo_fingerprint="$(printf 'echo|%s' "$internal_identity" | hash_identity)"
      device_fingerprint="$(printf 'data|%s|%s' "$internal_identity" "$sd_identity" | hash_identity)"
      connection_token="$(printf '%s|%s|%s' "$device_fingerprint" \
        "$(block_connection_sequence "$internal_device")" \
        "$(block_connection_sequence "$sd_device")" | hash_identity)"
      mount_token="$([[ -n "$internal_mount" ]] && echo mounted || echo unmounted)-$([[ -n "$sd_mount" ]] && echo mounted || echo unmounted)"
      ;;
    dac)
      echo_fingerprint=unknown
      device_fingerprint=dac
      connection_token=dac
      mount_token=dac
      ;;
    error)
      echo_fingerprint=unknown
      device_fingerprint=error
      connection_token=error
      mount_token=error
      ;;
    *)
      echo_fingerprint=unknown
      device_fingerprint=disconnected
      connection_token=disconnected
      mount_token=disconnected
      ;;
  esac
}

scope_firmware_state() {
  local scoped name legacy target migration_marker last_device="$config_root/last-device"
  if [[ "$mode" == dac && -f "$last_device" ]]; then
    read -r echo_fingerprint < "$last_device"
    [[ "$echo_fingerprint" =~ ^[0-9a-f]{64}$ ]] || return
    scoped="$config_root/devices/$echo_fingerprint"
    [[ -d "$scoped" ]] || return
    firmware_config="$scoped/firmware-version"
    firmware_pending="$scoped/firmware-pending"
    firmware_prepared="$scoped/firmware-prepared"
    return
  fi
  [[ "$mode" == data && -n "$internal_device" && "$echo_fingerprint" != unknown ]] || return
  scoped="$config_root/devices/$echo_fingerprint"
  mkdir -p "$scoped"
  migration_marker="$config_root/.device-state-migrated"
  if [[ ! -f "$migration_marker" ]]; then
    for name in firmware-version firmware-pending firmware-prepared; do
      legacy="$config_root/$name"
      target="$scoped/$name"
      [[ -f "$target" || ! -f "$legacy" ]] || cp -p "$legacy" "$target"
    done
    : > "$migration_marker"
  fi
  firmware_config="$scoped/firmware-version"
  firmware_pending="$scoped/firmware-pending"
  firmware_prepared="$scoped/firmware-prepared"
  [[ -f "$last_device" ]] && grep -Fqx "$echo_fingerprint" "$last_device" \
    || printf '%s\n' "$echo_fingerprint" > "$last_device"
}

scope_details_cache() {
  [[ "$mode" == data || "$mode" == dac ]] || return
  details_cache="$cache_root/details-$device_fingerprint"
}

rescan_devices() {
  mode=disconnected
  internal_device=
  internal_mount=
  sd_device=
  sd_mount=
  scan_error=
  runtime_error=
  check_runtime >/dev/null 2>&1 || true
  [[ "$mode" == error ]] || scan_devices
  refresh_device_identity
  scope_details_cache
  scope_firmware_state
}

require_unambiguous_device() {
  [[ -z "$scan_error" ]] || { echo "$scan_error"; return 1; }
}

valid_echo_properties() {
  local properties="$1" expected_model="$2"
  grep -q '^DEVTYPE=partition$' <<<"$properties" \
    && grep -q '^ID_VENDOR_ID=071b$' <<<"$properties" \
    && grep -q '^ID_MODEL_ID=3203$' <<<"$properties" \
    && grep -q "^ID_MODEL=${expected_model}$" <<<"$properties"
}

valid_echo_partition() {
  local device="$1" expected_model="$2" properties
  [[ -b "$device" ]] || return 1
  properties="$(udevadm info --query=property --name="$device" 2>/dev/null || true)"
  valid_echo_properties "$properties" "$expected_model"
}

safe_eject() {
  local device message label unmounted=""
  [[ "$mode" == data ]] || { echo "Echo Mini is not in USB Data mode"; return 1; }
  require_commands udisksctl || return 1
  require_unambiguous_device || return 1
  [[ -n "$internal_device" || -n "$sd_device" ]] \
    || { echo "No Echo volumes were found"; return 1; }
  if [[ -n "$internal_device" ]]; then
    valid_echo_partition "$internal_device" MINI \
      || { echo "Internal identity check failed"; return 1; }
  fi
  if [[ -n "$sd_device" ]]; then
    valid_echo_partition "$sd_device" MINI_SD \
      || { echo "SD identity check failed"; return 1; }
  fi

  for device in "$sd_device" "$internal_device"; do
    [[ -n "$device" ]] || continue
    [[ "$device" == "$sd_device" ]] && label="SD card" || label="internal memory"
    if findmnt -n -S "$device" >/dev/null 2>&1; then
      [[ "$device" == "$sd_device" ]] \
        && emit_progress 40 "Unmounting SD card" \
        || emit_progress 70 "Unmounting internal memory"
      message="$(udisksctl unmount -b "$device" 2>&1)" \
        || {
          if [[ -n "$unmounted" ]]; then
            echo "$unmounted safely unmounted; $label is still mounted: ${message:-unmount failed}"
          else
            echo "$label is still mounted: ${message:-unmount failed}"
          fi
          return 1
        }
      [[ -n "$unmounted" ]] && unmounted="$unmounted and $label" || unmounted="$label"
    fi
  done

  if { [[ -n "$sd_device" ]] && findmnt -n -S "$sd_device" >/dev/null 2>&1; } \
      || { [[ -n "$internal_device" ]] && findmnt -n -S "$internal_device" >/dev/null 2>&1; }; then
    echo "A volume is still mounted"
    return 1
  fi

  emit_progress 95 "Verifying volumes"
  echo "Echo volumes unmounted · safe to disconnect from Linux"
}

usage() {
  local mountpoint="$1"
  [[ -n "$mountpoint" ]] || { echo "Not mounted"; return; }
  df -hP "$mountpoint" | awk 'NR == 2 { print $3 " / " $2 }'
}

usage_percent() {
  local mountpoint="$1"
  [[ -n "$mountpoint" ]] || { echo 0; return; }
  df -P "$mountpoint" | awk 'NR == 2 { gsub(/%/, "", $5); print $5 }'
}

emit_progress() {
  printf 'PROGRESS\t%s\t%s\n' "$1" "$2"
}

read_cached_details() {
  [[ -f "$details_cache" ]] || return 1
  cat "$details_cache"
}

track_count() {
  local file count=0
  [[ -n "$sd_mount" ]] || { echo 0; return; }
  while IFS= read -r -d '' file; do count=$((count + 1)); done < <(
    find "$sd_mount" -type f \( -iname '*.flac' -o -iname '*.m4a' -o -iname '*.mp3' \
    -o -iname '*.wav' -o -iname '*.ape' -o -iname '*.ogg' -o -iname '*.dsf' \) \
    -print0 2>/dev/null)
  echo "$count"
}

file_count() {
  local pattern="$1" file count=0
  [[ -n "$sd_mount" ]] || { echo 0; return; }
  while IFS= read -r -d '' file; do count=$((count + 1)); done \
    < <(find "$sd_mount" -type f -iname "$pattern" -print0 2>/dev/null)
  echo "$count"
}

category_count() {
  local category count=0
  [[ -n "$sd_mount" ]] || { echo 0; return; }
  while IFS= read -r -d '' category; do count=$((count + 1)); done \
    < <(find "$sd_mount" -mindepth 1 -maxdepth 1 -type d -name '0[1-9]_*' -print0 2>/dev/null)
  echo "$count"
}

album_count() {
  local category album total=0 count
  [[ -n "$sd_mount" ]] || { echo 0; return; }
  while IFS= read -r -d '' category; do
    count=0
    while IFS= read -r -d '' album; do count=$((count + 1)); done \
      < <(find "$category" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)
    total=$((total + count))
  done < <(find "$sd_mount" -mindepth 1 -maxdepth 1 -type d -name '0[1-9]_*' -print0 2>/dev/null)
  echo "$total"
}

manifest_status() {
  [[ -n "$sd_mount" ]] || { echo "Not mounted"; return; }
  if [[ -f "$sd_mount/00_README.txt" && -f "$sd_mount/00_SNOWSKY_ACTIVE_BATCH.csv" ]]; then
    echo Ready
  else
    echo Missing
  fi
}

cleanup_status() {
  local count
  count="$(file_count '._*')"
  if [[ "$count" == 0 ]]; then
    echo Clean
  else
    echo "$count AppleDouble files"
  fi
}

file_size() {
  stat -c %s "$1" 2>/dev/null || stat -f %z "$1"
}

file_mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1"
}

has_required_space() {
  local available="$1" required="$2" reserve="$3"
  ((available >= required + reserve))
}

plugin_version() {
  sed -n 's/.*"version": "\([^"]*\)".*/\1/p' "$plugin_dir/manifest.json" | head -n 1
}

device_status() {
  local properties revision size variant
  [[ -n "$internal_device" ]] || { echo "Unknown"; return; }
  properties="$(udevadm info --query=property --name="$internal_device" 2>/dev/null || true)"
  revision="$(sed -n 's/^ID_REVISION=//p' <<<"$properties")"
  size="$(lsblk -bno SIZE "$internal_device" 2>/dev/null | tr -d ' ')"
  variant=512MB
  [[ -n "$size" ]] && ((size > 1073741824)) && variant=8GB
  echo "$variant · rev ${revision:-unknown}"
}

version_is_older() {
  local -a left right
  local index left_part right_part
  IFS=. read -ra left <<<"$1"
  IFS=. read -ra right <<<"$2"
  for index in 0 1 2; do
    left_part=$((10#${left[$index]:-0}))
    right_part=$((10#${right[$index]:-0}))
    ((left_part < right_part)) && return 0
    ((left_part > right_part)) && return 1
  done
  return 1
}

firmware_status() {
  local installed=unknown latest=unknown pending=unknown prepared=unknown
  [[ -f "$firmware_config" ]] && read -r installed < "$firmware_config"
  [[ -f "$firmware_cache" ]] && read -r latest < "$firmware_cache"
  [[ -f "$firmware_pending" ]] && read -r pending < "$firmware_pending"
  [[ -f "$firmware_prepared" ]] && read -r prepared < "$firmware_prepared"
  [[ "$installed" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || installed=unknown
  [[ "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || latest=unknown
  [[ "$pending" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || pending=unknown
  [[ "$prepared" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || prepared=unknown
  if [[ "$pending" != unknown && "$installed" != unknown ]]; then
    echo "$installed → $pending pending confirmation"
  elif [[ "$pending" != unknown ]]; then
    echo "$pending pending confirmation"
  elif [[ "$prepared" != unknown && "$installed" != unknown ]]; then
    echo "$installed → $prepared package ready"
  elif [[ "$prepared" != unknown ]]; then
    echo "$prepared package ready"
  elif [[ "$installed" == unknown ]]; then
    echo "Installed unknown · latest $latest"
  elif [[ "$latest" == unknown ]]; then
    echo "$installed · latest unknown"
  elif version_is_older "$installed" "$latest"; then
    echo "$installed → $latest available"
  elif [[ "$installed" == "$latest" ]]; then
    echo "$installed · up to date"
  else
    echo "$installed · newer than feed"
  fi
}

firmware_state() {
  local installed=unknown latest=unknown
  [[ "$(firmware_pending_status)" == yes ]] && { echo pending; return; }
  [[ "$(firmware_prepared_status)" == yes ]] && { echo prepared; return; }
  [[ -f "$firmware_config" ]] && read -r installed < "$firmware_config"
  [[ -f "$firmware_cache" ]] && read -r latest < "$firmware_cache"
  [[ "$installed" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo unknown; return; }
  [[ "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo feed_unknown; return; }
  if version_is_older "$installed" "$latest"; then
    echo available
  elif [[ "$installed" == "$latest" ]]; then
    echo current
  else
    echo newer
  fi
}

firmware_pending_status() {
  local pending
  [[ -f "$firmware_pending" ]] || { echo no; return; }
  read -r pending < "$firmware_pending"
  [[ "$pending" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && echo yes || echo no
}

firmware_pending_version() {
  [[ "$(firmware_pending_status)" == yes ]] && head -n 1 "$firmware_pending" || echo unknown
}

firmware_installed_version() {
  local version
  [[ -f "$firmware_config" ]] || { echo unknown; return; }
  read -r version < "$firmware_config"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && echo "$version" || echo unknown
}

firmware_backup_status() {
  local path_file backup
  for path_file in "$firmware_store"/*/backup-path; do
    [[ -f "$path_file" ]] || continue
    read -r backup < "$path_file"
    if [[ -d "$backup" && ! -f "$backup/.echo-shelf-backup-complete" ]] \
        && find "$backup" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null | grep -q .; then
      : > "$backup/.echo-shelf-backup-complete"
    fi
  done
  find "$firmware_backup_root" -mindepth 2 -maxdepth 2 -type f \
    -name '.echo-shelf-backup-complete' -print -quit 2>/dev/null \
    | grep -q . && echo yes || echo no
}

firmware_checked_at() {
  [[ -f "$firmware_cache" ]] || { echo 0; return; }
  stat -c %Y "$firmware_cache" 2>/dev/null || stat -f %m "$firmware_cache" 2>/dev/null || echo 0
}

firmware_feed_status() {
  local checked now age
  checked="$(firmware_checked_at)"
  [[ "$checked" =~ ^[0-9]+$ && "$checked" != 0 ]] || { echo unavailable; return; }
  now="$(date +%s)"
  age=$((now - checked))
  ((age <= 43200)) && echo fresh || echo stale
}

trusted_firmware_metadata() {
  local version="${1:-}" trust_file="$plugin_dir/firmware-trust.tsv" line count url archive_hash image_hash image_name
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && -f "$trust_file" ]] || return 1
  line="$(awk -F '\t' -v version="$version" '$1 == version { print $2 "\t" $3 "\t" $4 "\t" $5 }' "$trust_file")"
  count="$(awk -F '\t' -v version="$version" '$1 == version { count++ } END { print count+0 }' "$trust_file")"
  [[ "$count" == 1 ]] || return 1
  IFS=$'\t' read -r url archive_hash image_hash image_name <<<"$line"
  [[ "$url" == https://fiio-firmware.oss-us-west-1.aliyuncs.com/ECHO%20MINI/*"V${version}-8G.zip" \
      && "$archive_hash" =~ ^[0-9a-f]{64}$ && "$image_hash" =~ ^[0-9a-f]{64}$ \
      && "$image_name" =~ ^HIFIEC[0-9]+\.IMG$ ]] || return 1
  printf '%s\n' "$line"
}

firmware_source_trusted() {
  local metadata expected_url
  metadata="$(trusted_firmware_metadata "${1:-}")" || return 1
  IFS=$'\t' read -r expected_url _ <<<"$metadata"
  [[ "${2:-}" == "$expected_url" ]]
}

file_matches_sha256() {
  local file="$1" expected="$2" actual
  [[ -f "$file" && "$expected" =~ ^[0-9a-f]{64}$ ]] || return 1
  actual="$(sha256sum "$file" | awk '{ print $1 }')" || return 1
  [[ "$actual" == "$expected" ]]
}

mark_firmware_pending() {
  local version="${1:-}" latest temporary
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  [[ -f "$firmware_cache" ]] || return 1
  read -r latest < "$firmware_cache"
  [[ "$version" == "$latest" ]] || return 1
  mkdir -p "$config_root"
  temporary="$(mktemp "$config_root/.firmware-pending.XXXXXX")"
  printf '%s\n' "$version" > "$temporary"
  mv "$temporary" "$firmware_pending"
  echo "$version pending confirmation"
}

confirm_firmware() {
  local pending
  [[ -f "$firmware_pending" ]] || { echo "No firmware pending confirmation"; return 1; }
  read -r pending < "$firmware_pending"
  [[ "$pending" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
    || { echo "Invalid pending firmware version"; return 1; }
  mkdir -p "$config_root"
  mv "$firmware_pending" "$firmware_config"
  echo "$pending installed · confirmed"
}

check_updates() {
  local page latest download_url temporary temporary_url
  page="$(curl -LfsS --max-time 15 "$firmware_url")" \
    || { [[ -f "$firmware_cache" ]] && cat "$firmware_cache"; return 1; }
  latest="$(grep -oE 'ECHO MINI[^<]{0,80}V[0-9]+\.[0-9]+\.[0-9]+' <<<"$page" \
    | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | sort -Vu | tail -n 1)"
  [[ "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  download_url="$(grep -oE "https?[^\"<> ]+V${latest}-8G\\.zip" <<<"$page" | head -n 1)"
  [[ "$download_url" == https://fiio-firmware.* ]] || return 1
  mkdir -p "$cache_root"
  temporary="$(mktemp "$cache_root/.latest-firmware.XXXXXX")"
  temporary_url="$(mktemp "$cache_root/.latest-firmware-url.XXXXXX")"
  printf '%s\n' "$latest" > "$temporary"
  printf '%s\n' "$download_url" > "$temporary_url"
  mv "$temporary" "$firmware_cache"
  mv "$temporary_url" "$firmware_url_cache"
  echo "$latest"
}

firmware_prepared_status() {
  local version
  [[ -f "$firmware_prepared" ]] || { echo no; return; }
  read -r version < "$firmware_prepared"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && echo yes || echo no
}

firmware_prepared_version() {
  [[ "$(firmware_prepared_status)" == yes ]] && head -n 1 "$firmware_prepared" || echo unknown
}

validate_firmware_package() {
  local archive="$1" version="$2" output="$3" entry count size
  unzip -tqq "$archive" >/dev/null 2>&1 || return 1
  entry="$(LC_ALL=C unzip -Z1 "$archive" | LC_ALL=C grep -E '(^|/)HIFIEC[0-9]+\.IMG$' | head -n 1)"
  count="$(LC_ALL=C unzip -Z1 "$archive" | LC_ALL=C grep -Ec '(^|/)HIFIEC[0-9]+\.IMG$' || true)"
  [[ "$count" == 1 && -n "$entry" ]] || return 1
  [[ "$entry" == *"V${version}-8G"* ]] || return 1
  validated_image_name="${entry##*/}"
  unzip -p "$archive" "*/$validated_image_name" > "$output" || return 1
  size="$(file_size "$output")"
  ((size >= 16777216 && size <= 67108864)) || return 1
}

prepare_firmware() (
  local version download_url version_dir workdir archive image image_name
  local trusted_metadata trusted_url zip_hash image_hash trusted_image_name timestamp backup temporary
  local state new conflicts unchanged skipped unsupported
  workdir=
  trap '[[ -z "$workdir" || ! -d "$workdir" ]] || rm -r -- "$workdir"' EXIT
  emit_progress 5 "Checking Echo Mini"
  require_commands curl unzip rsync || return 1
  [[ "$mode" == data ]] || { echo "Echo Mini is not in USB Data mode"; return 1; }
  require_unambiguous_device || return 1
  [[ -n "$internal_device" && -n "$internal_mount" && -n "$sd_device" && -n "$sd_mount" ]] \
    || { echo "Connect both Echo volumes before preparing firmware"; return 1; }
  valid_echo_partition "$internal_device" MINI \
    || { echo "Internal identity check failed"; return 1; }
  valid_echo_partition "$sd_device" MINI_SD \
    || { echo "SD identity check failed"; return 1; }
  [[ "$(device_status)" == 8GB* ]] \
    || { echo "Firmware preparation requires the detected 8GB model"; return 1; }
  IFS=$'\t' read -r state new conflicts unchanged skipped unsupported <<<"$(import_preview_counts)"
  [[ "$state" == ok && "$new" == 0 && "$conflicts" == 0 ]] \
    || { echo "Import or resolve the Library before firmware preparation"; return 1; }

  emit_progress 15 "Checking official release"
  check_updates >/dev/null || { echo "Could not refresh official firmware metadata"; return 1; }
  read -r version < "$firmware_cache"
  read -r download_url < "$firmware_url_cache"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  trusted_metadata="$(trusted_firmware_metadata "$version")" \
    || { echo "Firmware $version is not trusted by this Echo Shelf release"; return 1; }
  IFS=$'\t' read -r trusted_url zip_hash image_hash trusted_image_name <<<"$trusted_metadata"
  firmware_source_trusted "$version" "$download_url" \
    || { echo "Official firmware URL does not match trusted release metadata"; return 1; }

  mkdir -p "$firmware_store"
  version_dir="$firmware_store/$version"
  mkdir -p "$version_dir"
  workdir="$(mktemp -d "$firmware_store/.prepare-${version}.XXXXXX")"
  archive="$workdir/firmware.zip"
  image="$workdir/firmware.IMG"
  emit_progress 25 "Downloading firmware"
  curl -LfsS --proto '=https' --tlsv1.2 --max-time 120 "$download_url" -o "$archive" \
    || { echo "Firmware download failed"; return 1; }
  emit_progress 45 "Verifying trusted archive"
  file_matches_sha256 "$archive" "$zip_hash" \
    || { echo "Firmware archive SHA-256 does not match this Echo Shelf release"; return 1; }
  emit_progress 50 "Validating package"
  validate_firmware_package "$archive" "$version" "$image" \
    || { echo "Firmware package validation failed"; return 1; }
  image_name="$validated_image_name"
  [[ "$image_name" == "$trusted_image_name" ]] && file_matches_sha256 "$image" "$image_hash" \
    || { echo "Firmware image SHA-256 does not match this Echo Shelf release"; return 1; }

  emit_progress 65 "Backing up internal storage"
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup="$firmware_backup_root/${timestamp}-pre-${version}"
  mkdir -p "$backup"
  rsync -rt --exclude='*.IMG' --exclude='*.img' -- "$internal_mount/" "$backup/" \
    || { rm -r -- "$backup"; echo "Internal memory backup failed"; return 1; }
  printf '%s\n' "$version" > "$backup/.echo-shelf-backup-complete"

  emit_progress 90 "Saving validated package"
  mv "$archive" "$version_dir/firmware.zip"
  mv "$image" "$version_dir/$image_name"
  printf '%s  firmware.zip\n' "$zip_hash" > "$version_dir/firmware.zip.sha256"
  printf '%s  %s\n' "$image_hash" "$image_name" > "$version_dir/$image_name.sha256"
  printf '%s\n' "$image_name" > "$version_dir/image-name"
  printf '%s\n' "$download_url" > "$version_dir/source-url"
  printf '%s\n' "$backup" > "$version_dir/backup-path"
  rm -r "$workdir"
  workdir=
  mkdir -p "$config_root"
  temporary="$(mktemp "$config_root/.firmware-prepared.XXXXXX")"
  printf '%s\n' "$version" > "$temporary"
  mv "$temporary" "$firmware_prepared"
  emit_progress 100 "Package ready"
  echo "$version package ready · safely eject, remove SD, reconnect Data"
)

install_prepared_firmware() (
  local version version_dir image_name image expected_hash recorded_hash target temporary_target
  local trusted_metadata trusted_url trusted_archive_hash trusted_image_name
  temporary_target=
  trap '[[ -z "$temporary_target" || ! -f "$temporary_target" ]] || rm -f -- "$temporary_target"' EXIT
  emit_progress 10 "Validating prepared firmware"
  require_commands udisksctl || return 1
  [[ "$mode" == data ]] || { echo "Echo Mini is not in USB Data mode"; return 1; }
  require_unambiguous_device || return 1
  [[ -n "$internal_device" && -n "$internal_mount" ]] \
    || { echo "Echo internal memory is not mounted"; return 1; }
  [[ -z "$sd_device" ]] || { echo "Remove the SD card before installing firmware"; return 1; }
  valid_echo_partition "$internal_device" MINI \
    || { echo "Internal identity check failed"; return 1; }
  [[ "$(device_status)" == 8GB* ]] || { echo "Expected the 8GB Echo Mini"; return 1; }
  [[ "$(firmware_prepared_status)" == yes ]] || { echo "No prepared firmware"; return 1; }
  version="$(firmware_prepared_version)"
  trusted_metadata="$(trusted_firmware_metadata "$version")" \
    || { echo "Firmware $version is not trusted by this Echo Shelf release"; return 1; }
  IFS=$'\t' read -r trusted_url trusted_archive_hash expected_hash trusted_image_name \
    <<<"$trusted_metadata"
  version_dir="$firmware_store/$version"
  [[ -f "$version_dir/image-name" ]] || { echo "Prepared firmware metadata missing"; return 1; }
  read -r image_name < "$version_dir/image-name"
  [[ "$image_name" == "$trusted_image_name" ]] \
    || { echo "Prepared firmware image name is not trusted"; return 1; }
  image="$version_dir/$image_name"
  [[ -f "$image" && -f "$image.sha256" ]] || { echo "Prepared firmware files missing"; return 1; }
  recorded_hash="$(awk 'NR == 1 { print $1 }' "$image.sha256")"
  [[ "$recorded_hash" == "$expected_hash" ]] \
    || { echo "Prepared firmware metadata is not trusted"; return 1; }
  file_matches_sha256 "$image" "$expected_hash" \
    || { echo "Prepared firmware SHA-256 does not match this Echo Shelf release"; return 1; }
  ! find "$internal_mount" -maxdepth 1 -type f -iname '*.img' -print -quit | grep -q . \
    || { echo "An existing firmware image is already on the Echo"; return 1; }
  has_required_space "$(df -PB1 "$internal_mount" | awk 'NR == 2 { print $4 }')" \
    "$(file_size "$image")" 1048576 \
    || { echo "Not enough internal storage for firmware"; return 1; }

  emit_progress 30 "Copying firmware to Echo"
  target="$internal_mount/$image_name"
  temporary_target="$internal_mount/.${image_name}.part"
  cp "$image" "$temporary_target" || { echo "Firmware copy failed"; return 1; }
  sync -f "$internal_mount" || { echo "Could not flush firmware writes"; return 1; }
  emit_progress 65 "Verifying copied image"
  [[ "$(sha256sum "$temporary_target" | awk '{ print $1 }')" == "$expected_hash" ]] \
    || { echo "Firmware copy checksum failed"; return 1; }
  mv "$temporary_target" "$target"
  temporary_target=
  sync -f "$internal_mount" || {
    rm -f -- "$target"
    sync -f "$internal_mount" >/dev/null 2>&1 || true
    echo "Could not flush final firmware image"
    return 1
  }
  [[ "$(sha256sum "$target" | awk '{ print $1 }')" == "$expected_hash" ]] \
    || {
      rm -f -- "$target"
      sync -f "$internal_mount" >/dev/null 2>&1 || true
      echo "Final firmware checksum failed; invalid image removed"
      return 1
    }
  emit_progress 90 "Safely unmounting Echo"
  mark_firmware_pending "$version" >/dev/null \
    || { echo "Firmware copied, but pending state could not be recorded"; return 1; }
  rm -f "$firmware_prepared"
  udisksctl unmount -b "$internal_device" >/dev/null 2>&1 \
    || { echo "Firmware copied, but internal memory could not be safely unmounted"; return 1; }
  emit_progress 100 "Ready to restart"
  echo "$version copied and verified · restart Echo · pending confirmation"
)

is_transfer_file() {
  case "${1,,}" in
    *.flac|*.m4a|*.mp3|*.wav|*.ape|*.ogg|*.dsf|*/cover.jpg|*/folder.jpg) return 0 ;;
    *) return 1 ;;
  esac
}

files_match() {
  local source="$1" target="$2" source_time target_time difference
  [[ -f "$target" ]] || return 1
  [[ "$(file_size "$source")" == "$(file_size "$target")" ]] || return 1
  # ponytail: FAT size+mtime keeps refreshes fast; add opt-in hashes only if collisions appear.
  source_time="$(file_mtime "$source")"
  target_time="$(file_mtime "$target")"
  difference=$((source_time - target_time))
  ((difference < 0)) && difference=$((-difference))
  ((difference <= 1))
}

case_collision_count() {
  local source relative lowered count=0
  local -A seen=()
  while IFS= read -r -d '' source; do
    is_transfer_file "$source" || continue
    relative="${source#"$inbox"/}"
    [[ "$relative" == 0[1-9]_*/*/* ]] || continue
    lowered="${relative,,}"
    if [[ -n "${seen[$lowered]:-}" ]]; then
      count=$((count + 1))
    else
      seen[$lowered]=1
    fi
  done < <(find "$inbox" -type f -print0 2>/dev/null)
  echo "$count"
}

sync_preview_counts() {
  local source relative target
  local new=0 updated=0 unchanged=0 skipped=0 unsupported=0
  [[ -d "$inbox" ]] || { printf 'inbox_missing\t0\t0\t0\t0\t0\n'; return; }
  [[ -n "$sd_mount" ]] || { printf 'sd_missing\t0\t0\t0\t0\t0\n'; return; }

  while IFS= read -r -d '' source; do
    relative="${source#"$inbox"/}"
    if [[ "${source,,}" == *.wv ]]; then
      unsupported=$((unsupported + 1))
      continue
    fi
    is_transfer_file "$source" || continue
    if [[ "$relative" != 0[1-9]_*/*/* ]]; then
      skipped=$((skipped + 1))
      continue
    fi
    target="$sd_mount/$relative"
    if [[ ! -f "$target" ]]; then
      new=$((new + 1))
    elif files_match "$source" "$target"; then
      unchanged=$((unchanged + 1))
    else
      updated=$((updated + 1))
    fi
  done < <(find "$inbox" -type f -print0 2>/dev/null)

  printf 'ok\t%s\t%s\t%s\t%s\t%s\n' "$new" "$updated" "$unchanged" "$skipped" "$unsupported"
}

sync_preview() {
  local state new updated unchanged skipped unsupported
  IFS=$'\t' read -r state new updated unchanged skipped unsupported <<<"$(sync_preview_counts)"
  case "$state" in
    inbox_missing) echo "Inbox missing" ;;
    sd_missing) echo "SD not mounted" ;;
    *) echo "$new new · $updated updated · $unchanged unchanged · $skipped skipped · $unsupported unsupported" ;;
  esac
}

import_preview_counts() {
  local source relative target
  local new=0 conflicts=0 unchanged=0 skipped=0 unsupported=0
  [[ -n "$sd_mount" ]] || { printf 'sd_missing\t0\t0\t0\t0\t0\n'; return; }

  while IFS= read -r -d '' source; do
    relative="${source#"$sd_mount"/}"
    if [[ "${source,,}" == *.wv ]]; then
      unsupported=$((unsupported + 1))
      continue
    fi
    is_transfer_file "$source" || continue
    if [[ "$relative" != 0[1-9]_*/*/* ]]; then
      skipped=$((skipped + 1))
      continue
    fi
    target="$library/$relative"
    if [[ ! -f "$target" ]]; then
      new=$((new + 1))
    elif files_match "$source" "$target"; then
      unchanged=$((unchanged + 1))
    else
      conflicts=$((conflicts + 1))
    fi
  done < <(find "$sd_mount" -type f -print0 2>/dev/null)

  printf 'ok\t%s\t%s\t%s\t%s\t%s\n' "$new" "$conflicts" "$unchanged" "$skipped" "$unsupported"
}

import_preview() {
  local state new conflicts unchanged skipped unsupported
  IFS=$'\t' read -r state new conflicts unchanged skipped unsupported <<<"$(import_preview_counts)"
  if [[ "$state" == sd_missing ]]; then
    echo "SD not mounted"
  else
    echo "$new new · $conflicts conflicts · $unchanged unchanged · $skipped skipped · $unsupported unsupported"
  fi
}

import_required_bytes() {
  local source relative total=0
  while IFS= read -r -d '' source; do
    relative="${source#"$sd_mount"/}"
    [[ "$relative" == 0[1-9]_*/*/* ]] || continue
    [[ -e "$library/$relative" ]] || total=$((total + $(file_size "$source")))
  done < <(find "$sd_mount" -type f \( -iname '*.flac' -o -iname '*.m4a' -o -iname '*.mp3' \
    -o -iname '*.wav' -o -iname '*.ape' -o -iname '*.ogg' -o -iname '*.dsf' \
    -o -iname 'cover.jpg' -o -iname 'folder.jpg' \) -print0 2>/dev/null)
  echo "$total"
}

sync_required_bytes() {
  local source relative target total=0
  while IFS= read -r -d '' source; do
    relative="${source#"$inbox"/}"
    is_transfer_file "$source" || continue
    [[ "$relative" == 0[1-9]_*/*/* ]] || continue
    target="$sd_mount/$relative"
    files_match "$source" "$target" || total=$((total + $(file_size "$source")))
  done < <(find "$inbox" -type f -print0 2>/dev/null)
  echo "$total"
}

copy_echo_to_library() {
  local source relative list result
  list="$(mktemp)"
  mkdir -p "$library"

  while IFS= read -r -d '' source; do
    relative="${source#"$sd_mount"/}"
    [[ "$relative" == 0[1-9]_*/*/* ]] || continue
    [[ -e "$library/$relative" ]] && continue
    printf '%s\0' "$relative" >> "$list"
  done < <(find "$sd_mount" -type f \( -iname '*.flac' -o -iname '*.m4a' -o -iname '*.mp3' \
    -o -iname '*.wav' -o -iname '*.ape' -o -iname '*.ogg' -o -iname '*.dsf' \
    -o -iname 'cover.jpg' -o -iname 'folder.jpg' \) -print0 2>/dev/null)

  rsync -rt --ignore-existing --delay-updates --modify-window=1 --from0 --files-from="$list" \
    -- "$sd_mount/" "$library/"
  result=$?
  rm -f "$list"
  return "$result"
}

import_from_echo() {
  local required available preview state new conflicts unchanged skipped unsupported reserve=536870912
  emit_progress 10 "Checking Echo library"
  require_commands rsync || return 1
  [[ "$mode" == data ]] || { echo "Echo Mini is not in USB Data mode"; return 1; }
  require_unambiguous_device || return 1
  [[ -n "$sd_device" && -n "$sd_mount" ]] \
    || { echo "Echo Mini SD is not mounted"; return 1; }
  valid_echo_partition "$sd_device" MINI_SD \
    || { echo "SD identity check failed"; return 1; }

  emit_progress 25 "Checking local storage"
  required="$(import_required_bytes)"
  available="$(df -PB1 "$music_root" | awk 'NR == 2 { print $4 }')"
  has_required_space "$available" "$required" "$reserve" \
    || { echo "Not enough local disk space"; return 1; }
  emit_progress 40 "Copying new music"
  copy_echo_to_library || { echo "Import copy failed"; return 1; }
  sync -f "$library" || { echo "Could not flush Library writes"; return 1; }
  emit_progress 85 "Verifying Library"
  preview="$(import_preview)"
  IFS=$'\t' read -r state new conflicts unchanged skipped unsupported <<<"$(import_preview_counts)"
  [[ "$state" == ok && "$new" == 0 ]] \
    || { echo "Import verification failed: $preview"; return 1; }
  [[ "$conflicts" == 0 ]] \
    || { echo "Import finished with $conflicts conflicts; local files were preserved"; return 2; }
  emit_progress 100 "Library updated"
  echo "Import complete · $preview"
}

copy_inbox_to_sd() {
  local source relative list result
  list="$(mktemp)"

  while IFS= read -r -d '' source; do
    relative="${source#"$inbox"/}"
    [[ "$relative" == 0[1-9]_*/*/* ]] || continue
    printf '%s\0' "$relative" >> "$list"
  done < <(find "$inbox" -type f \( -iname '*.flac' -o -iname '*.m4a' -o -iname '*.mp3' \
    -o -iname '*.wav' -o -iname '*.ape' -o -iname '*.ogg' -o -iname '*.dsf' \
    -o -iname 'cover.jpg' -o -iname 'folder.jpg' \) -print0 2>/dev/null)

  rsync -rt --delay-updates --modify-window=1 --from0 --files-from="$list" -- "$inbox/" "$sd_mount/"
  result=$?
  rm -f "$list"
  return "$result"
}

sync_to_echo() {
  local required available preview collisions reserve=67108864
  emit_progress 10 "Checking Inbox"
  require_commands rsync || return 1
  [[ "$mode" == data ]] || { echo "Echo Mini is not in USB Data mode"; return 1; }
  require_unambiguous_device || return 1
  [[ -n "$sd_device" && -n "$sd_mount" ]] \
    || { echo "Echo Mini SD is not mounted"; return 1; }
  valid_echo_partition "$sd_device" MINI_SD \
    || { echo "SD identity check failed"; return 1; }
  [[ -d "$inbox" ]] || { echo "Inbox missing"; return 1; }
  collisions="$(case_collision_count)"
  [[ "$collisions" == 0 ]] \
    || { echo "$collisions case-insensitive filename collisions in Inbox"; return 1; }

  emit_progress 25 "Checking SD storage"
  required="$(sync_required_bytes)"
  available="$(df -PB1 "$sd_mount" | awk 'NR == 2 { print $4 }')"
  has_required_space "$available" "$required" "$reserve" \
    || { echo "Not enough SD card space"; return 1; }
  emit_progress 35 "Copying music to SD"
  copy_inbox_to_sd || { echo "Sync copy failed"; return 1; }
  sync -f "$sd_mount" || { echo "Could not flush SD writes"; return 1; }
  emit_progress 85 "Verifying SD card"
  preview="$(sync_preview)"
  [[ "$preview" == "0 new · 0 updated · "* ]] \
    || { echo "Sync verification failed: $preview"; return 1; }
  emit_progress 100 "Echo library updated"
  echo "Sync complete · $preview"
}

